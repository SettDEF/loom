# loom's login screen: the greeter (the user's own lock screen) on tty1, as its own user in a
# logind greeter session (PAMName); `systemctl enable` it instead of gdm (docs/greeter.md)
[Unit]
Description=loom login screen
Requires=loom-auth.service
After=loom-auth.service systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=loom-greeter
PAMName=loom-greeter
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=greeter XDG_SEAT=seat0 XDG_VTNR=1
Environment=XDG_CACHE_HOME=/var/lib/loom/greeter-cache LOOM_AUTH_SOCKET=/run/loom/auth.sock LOOM_HANDOVER_DIR=/run/loom/handover
ExecStart=/usr/local/bin/loom --tty --greeter /var/lib/loom/greeter
Restart=on-failure
# no core dumps: a password could be in one
LimitCORE=0

[Install]
Alias=display-manager.service
