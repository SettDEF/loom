#!/bin/sh
# loom-session: what the login screen (GDM) runs for the loom session: loom on the screen, the Hyprland config's exec-once programs started.
# Everything it says goes to ~/.local/state/loom/session-<time>.log. Installed by scripts/install.sh.
LOG_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/loom
mkdir -p "$LOG_DIR"
# the portals and the shell treat it as Hyprland (loom speaks Hyprland's IPC)
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=loom XDG_SESSION_TYPE=wayland
# your own build first (scripts/install.sh), else the installed one; options after it go to loom
# (the login screen adds --curtain DIR: its last picture over the start)
L=$HOME/.local/bin/loom
[ -x "$L" ] || L=$(command -v loom)
exec "$L" --tty --session "$@" > "$LOG_DIR/session-$(date +%Y%m%d-%H%M%S).log" 2>&1
